        border 1px solid red

.sec_flag__top
    flexx()
    flexalignx()
    
.sec_flag__left
    width 595px
    padding: varx(pd,bf)
    flex: 1

    & > img
        widthmx(globus)
        height: @width
        border 1px solid red
        border-radiusmx(globus)
