.header__menu 
    .nav_links
        display flex
        flex-direction row
        gap 4px
        max-height: 100%
        li
            padding 10px 2px
            transition: all var(--durations_min) ease

        li:hover
            border 1px solid var(--clr_wht_hex)
            border-radius: var(--rad_btn)
            background-color: @css{ rgba(var(--clr_wht), 22%) }

        
        li > a
            padding var( --pad_btn_top ) var( --pad_btn_left ) 
            font-weight: bold
            hover()
        
        li > a:hover
            transform: scale(1.05)
            transform: scale(110%)
            font-size: 1.1em
            color var(--clr_primary_hex)
