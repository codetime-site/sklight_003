body
    font-family 'Arial', sans-serif
    background-color #f5f5f5
    margin 0 auto
    padding 0
    height auto

header
    background-color #130202
    color white
    padding 20px
    display flex
    justify-content space-between
    flex-direction column
    flex-wrap nowrap
    justify-content center
    align-items center
    align-content center
    gap 32px

.header__top
.header__btm
    display flex
    flex-direction row
    justify-content space-around
    padding 15px 0
    align-items center
    gap 32px

.header__logo
    max-width 60px
    
    img
        width 100%


