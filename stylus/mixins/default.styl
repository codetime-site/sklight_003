paddingx(name = bs, t = top)
    varx( pd, name, t )

pdx(name = bs, t = top)
    paddingx(name, t)

// color_mixins 
// colormx(wht) =>  color:var(--color-wht_hex) => #ffffff
clrx(name, cat = clr )
    cat = cat == clr ? clr: clr_rgb
    varx(cat, name)

colormx( name = wht )
   color: unquote( "var(--color-"+ name +"_hex)" )

colorrgbmx( name = wht, n = 50%)
   color: @css{ unquote( "rgba(var(--color-"+ name +")", + n + " )" ) }

bgcmx( name = primary )
    background-color: unquote( "var(--color-" + name +"_hex)" )

bgcrgbmx( name = primary, n = 50% )
    background-color: @css{ unquote( "rgba(var(--color-"+ name +")", + n + " )" ) }

colorx( name = wht )
   return unquote( "var(--color-"+ name +"_hex)" )

color_rgbx( name = wht, n = 50%)
   return @css{ unquote( "rgba(var(--color-"+ name +")", + n + " )" ) }
// color end#

// border 
border-radiusmx( name1 = btn )   
    border-radius: unquote( "var(--radius-"+ name1 +")" )
// border_end

// font 
font-sizemx( name = p)
    font-size: unquote( "var( --font-size-"+ name + " )" )

font-weightmx( name = bolder)
    font-weight: unquote( "var( --font-weight-"+ name +" )" )
// font_end 

// width 
widthmx(name) 
    width: unquote( "var( --width-"+ name +" )" )

widthx(name) 
    return unquote( "var( --width-"+ name +" )" )

max-widthmx(name) 
    max-width: unquote( "var(--width-" + name +")" )
// width_end