html {
  box-sizing: border-box;
}

*, *::before, *::after {
  box-sizing: inherit;
}
a{
    text-decoration: none;
    color: white;
}
a:hover{
    color: #d68c50;
}

img 
    width: 100%
    height: auto

section
    border 1px solid $wht
    padding: $pd25 $pd50

.container
    cont()



.sec_dark
    background-color: var(--clr_dark_hex)
    color: var(--clr_wht_hex)

.sec_wht
    background-color: var(--clr_wht_hex)
    color var(--clr_dark_hex)


header
    width 100%



.btn
    btn()



    