html 
  box-sizing: border-box;


*, *::before, *::after 
  box-sizing: inherit;


section
    border 1px solid $wht
    padding: $pd25 $pd50

.container
    cont()

.sec_dark
    background-color: var(--clr_drk_hex)
    color: var(--clr_wht_hex)

.sec_wht
    background-color: var(--clr_wht_hex)
    color var(--clr_drk_hex)

header
    width 100%

h2 
    font-family: Arial, Helvetica, sans-serif
    font-sizemx(header)
    font-weightmx(700)

h3
    font-sizemx(header_3)
    font-weightmx(500)

p
    font-sizemx(parag)
    // line-height: 

a
    text-decoration: none;
    colormx(wht);

a:hover
    color_hex(wht);

img 
    min-width: 300px
    width: 100%
    max-width 652px
    min-height: 220px 
    height: @width
    max-height: 700px

.btn
    btn()

